{
  "name": "campus-task-sync",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sincroniza pendencias do calendario do Campus Virtual com gerenciadores de tarefas.",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "start": "node dist/src/cli.js",
    "setup:attendance": "tsx src/setup-attendance-cli.ts",
    "setup:drive": "tsx src/setup-drive-cli.ts",
    "setup:important-dates": "tsx src/setup-important-dates-cli.ts",
    "setup:notion": "tsx src/setup-notion-cli.ts",
    "setup:moodle": "tsx src/setup-moodle-token-cli.ts",
    "sync": "tsx src/cli.ts",
    "sync:drive": "tsx src/sync-drive-cli.ts",
    "sync:dry": "tsx src/cli.ts --dry-run",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web:dev": "npm run dev --workspace @campus-task-sync/web",
    "web:build": "npm run build --workspace @campus-task-sync/web",
    "web:typecheck": "npm run typecheck --workspace @campus-task-sync/web"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "ical.js": "^2.2.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
