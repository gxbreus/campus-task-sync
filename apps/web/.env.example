# URL publica do beta, usada nos retornos OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integração pública criada no portal de desenvolvedores do Notion.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Persistência das instalações sem conta própria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave aleatória de 32 bytes em base64 para criptografar tokens.
APP_ENCRYPTION_KEY=

# Protege a rota chamada pelo agendador.
SYNC_CRON_SECRET=
