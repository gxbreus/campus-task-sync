# URL privada gerada em "Exportar calendario" no Campus Virtual. Obrigatoria.
CALENDAR_ICS_URL=

# Recomendada: preenchida automaticamente por npm run setup:moodle.
MOODLE_TOKEN=

# Opcional: corrige creditos ausentes ou divergentes na consulta do Grade UFLA.
# O limite de faltas de cada disciplina sera o dobro dos creditos.
COURSE_CREDITS=

# Token e pagina sao necessarios para npm run setup:notion.
NOTION_TOKEN=
NOTION_PARENT_PAGE_URL=

# Preenchidos automaticamente por npm run setup:notion. Deixe vazios no primeiro uso.
NOTION_DATA_SOURCE_ID=
NOTION_ASSIGNEE_USER_ID=

# Opcionais: sincronizacao dos materiais do Campus com uma pasta do Google Drive.
GOOGLE_DRIVE_CREDENTIALS_PATH=.google-drive-credentials.json
GOOGLE_DRIVE_TOKEN_PATH=.google-drive-token.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Alternativa ao arquivo de token para execucao no GitHub Actions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Opcionais: habilitam a sugestao de resposta para tarefas sem resposta.
ENABLE_AI_SUGGESTIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
