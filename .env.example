# URL privada gerada em "Exportar calendario" no Campus Virtual.
CALENDAR_ICS_URL=https://campusvirtual.exemplo/calendar/export_execute.php?...

# Opcional: permite consultar detalhes e arquivos das atividades pela API do Moodle.
MOODLE_TOKEN=...

# Necessarios apenas para sincronizar com o Notion.
NOTION_TOKEN=secret_...
NOTION_PARENT_PAGE_URL=https://www.notion.so/Campus-Task-Sync-...
NOTION_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000
NOTION_ASSIGNEE_USER_ID=00000000-0000-0000-0000-000000000000

# Opcionais: sincronizacao dos materiais do Campus com uma pasta do Google Drive.
GOOGLE_DRIVE_CREDENTIALS_PATH=.google-drive-credentials.json
GOOGLE_DRIVE_TOKEN_PATH=.google-drive-token.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Alternativa ao arquivo de token para execucao no GitHub Actions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Opcionais: habilitam a sugestao de resposta para tarefas sem resposta.
ENABLE_AI_SUGGESTIONS=false
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-terra
